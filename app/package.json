    "@vitejs/plugin-react": "^4.3.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
